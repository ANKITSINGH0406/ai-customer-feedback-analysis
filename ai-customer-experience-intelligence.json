    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ai = $input.item.json.output;\nconst original = $('Edit Fields').item.json;\n\nlet riskScore = 0;\n\n// Sentiment\nif (ai.sentiment === \"Negative\") {\n  riskScore += 25;\n} else if (ai.sentiment === \"Neutral\") {\n  riskScore += 10;\n}\n\n// Priority\nif (ai.priority === \"Critical\") {\n  riskScore += 30;\n} else if (ai.priority === \"High\") {\n  riskScore += 20;\n} else if (ai.priority === \"Medium\") {\n  riskScore += 10;\n}\n\n// Churn Risk\nif (ai.churn_risk === \"High\") {\n  riskScore += 25;\n} else if (ai.churn_risk === \"Medium\") {\n  riskScore += 15;\n}\n\nriskScore = Math.min(riskScore, 100);\n\nlet riskLevel;\n\nif (riskScore >= 70) {\n  riskLevel = \"Critical\";\n} else if (riskScore >= 40) {\n  riskLevel = \"High\";\n} else if (riskScore >= 20) {\n  riskLevel = \"Medium\";\n} else {\n  riskLevel = \"Low\";\n}\n\nreturn {\n  json: {\n    Feedback_ID: original.Feedback_ID,\n    Customer_ID: original.Customer_ID,\n    Customer_Name: original.Customer_Name,\n    Date_Time: original.Date_Time,\n    Product: original.Product,\n    Region: original.Region,\n    Source: original.Source,\n    Customer_Value: original.Customer_Value,\n    Feedback: original.Feedback,\n\n    AI_Sentiment: ai.sentiment,\n    AI_Sentiment_Score: ai.sentiment_score,\n    Category: ai.category,\n    Subcategory: ai.subcategory,\n    Emotion: ai.emotion,\n    Root_Cause: ai.root_cause,\n    Priority: ai.priority,\n    Churn_Risk: ai.churn_risk,\n    Customer_Intent: ai.customer_intent,\n    AI_Summary: ai.summary,\n    Recommendation: ai.recommendation,\n\n    Risk_Score: riskScore,\n    Risk_Level: riskLevel,\n    Processed_Date: new Date().toISOString()\n  }\n};"
      },
