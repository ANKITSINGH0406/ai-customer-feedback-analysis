    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"sentiment\": {\n      \"type\": \"string\"\n    },\n    \"sentiment_score\": {\n      \"type\": \"number\"\n    },\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"subcategory\": {\n      \"type\": \"string\"\n    },\n    \"emotion\": {\n      \"type\": \"string\"\n    },\n    \"root_cause\": {\n      \"type\": \"string\"\n    },\n    \"priority\": {\n      \"type\": \"string\"\n    },\n    \"churn_risk\": {\n      \"type\": \"string\"\n    },\n    \"customer_intent\": {\n      \"type\": \"string\"\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"recommendation\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"sentiment\",\n    \"sentiment_score\",\n    \"category\",\n    \"subcategory\",\n    \"emotion\",\n    \"root_cause\",\n    \"priority\",\n    \"churn_risk\",\n    \"customer_intent\",\n    \"summary\",\n    \"recommendation\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1712,
        192
      ],
      "id": "2c569159-f91f-4e9e-944e-998ccfdf90fa",
      "name": "Structured Output Parser"
